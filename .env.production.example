# Copy to .env.production on the shared server and replace every placeholder.
POSTGRES_DB=stealthsync
DB_USERNAME=stealthsync
DB_PASSWORD=replace-with-a-long-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
OAUTH_STATE_SECRET=replace-with-a-different-random-secret
VAULT_SERVER_SECRET=replace-with-a-different-random-secret
TOKEN_ENCRYPTION_SECRET=replace-with-an-independent-random-secret

STEALTHSYNC_FRONTEND_URL=https://stealthsync.example
STEALTHSYNC_ALLOWED_ORIGINS=https://stealthsync.example
STEALTHSYNC_PORT=8080

GOOGLE_DRIVE_CLIENT_ID=replace-with-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://stealthsync.example/cloud-storage/google-drive/callback

DROPBOX_CLIENT_ID=replace-with-dropbox-client-id
DROPBOX_CLIENT_SECRET=replace-with-dropbox-client-secret
DROPBOX_REDIRECT_URI=https://stealthsync.example/cloud-storage/dropbox/callback

ONEDRIVE_CLIENT_ID=replace-with-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=replace-with-onedrive-client-secret
ONEDRIVE_REDIRECT_URI=https://stealthsync.example/cloud-storage/onedrive/callback
ONEDRIVE_TENANT=common
