# Public routing (no protocol or path in PUBLIC_DOMAIN)
PUBLIC_DOMAIN=stealthsync-fyp.duckdns.org
ACME_EMAIL=operator@example.com
TZ=Asia/Singapore

# PostgreSQL
POSTGRES_DB=stealthsync
POSTGRES_USER=stealthsync
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Generate four different random values. Do not reuse one secret here.
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-an-independent-random-secret
VAULT_SERVER_SECRET=replace-with-an-independent-random-secret
TOKEN_ENCRYPTION_SECRET=replace-with-an-independent-random-secret

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=replace-with-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_DRIVE_LOGIN_HINT=
GOOGLE_DRIVE_FOLDER_ID=

# Dropbox OAuth
DROPBOX_CLIENT_ID=replace-with-dropbox-client-id
DROPBOX_CLIENT_SECRET=replace-with-dropbox-client-secret

# Microsoft OneDrive OAuth
ONEDRIVE_CLIENT_ID=replace-with-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=replace-with-onedrive-client-secret
ONEDRIVE_TENANT=common

# Optional DuckDNS updater. These values are consumed only by
# update-duckdns.sh on the VM and are never passed into an application service.
DUCKDNS_SUBDOMAIN=stealthsync-fyp
DUCKDNS_TOKEN=replace-with-duckdns-token
